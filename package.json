{
  "name": "obsidian-setup-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Document an Obsidian setup without exporting private configuration data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "node scripts/check.mjs",
    "build": "npm run check && node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
